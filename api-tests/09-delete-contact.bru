meta {
  name: Delete Contact
  type: http
  seq: 11
}

delete {
  url: {{manageUrl}}/deleteContact.php?id={{contactId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-User-ID: {{userId}}
}

tests {
  test("contact delete returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("contact delete returns message", function() {
    expect(res.body.message).to.equal("Contact deleted!");
  });
}
