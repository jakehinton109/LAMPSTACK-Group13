meta {
  name: Delete Contact
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/deleteContact.php?id={{contactId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("contact delete returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("contact delete returns message", function() {
    expect(res.body.message).to.equal("Contact deleted!");
  });
}
