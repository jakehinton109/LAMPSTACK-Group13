meta {
  name: Filter Paged Contacts
  type: http
  seq: 6
}

get {
  url: {{pagingUrl}}/getContacts.php?page=1&limit=100&positions=QB,WR&sides=Offense
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-User-ID: {{userId}}
}

tests {
  test("filtered paging returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("filters are returned", function() {
    expect(res.body.filters.positions).to.include("QB");
    expect(res.body.filters.positions).to.include("WR");
    expect(res.body.filters.sides).to.include("Offense");
  });

  test("created contact matches filtered page", function() {
    const contact = res.body.results.find(
      item => item.id == bru.getEnvVar("contactId")
    );

    expect(contact).to.not.equal(undefined);
    expect(["QB", "WR"]).to.include(contact.position);
    expect(contact.side).to.equal("Offense");
  });

  test("all returned contacts match filters", function() {
    res.body.results.forEach(function(contact) {
      expect(["QB", "WR"]).to.include(contact.position);
      expect(contact.side).to.equal("Offense");
    });
  });
}
