meta {
  name: Admin - Change User Password
  type: http
  seq: 15
}

put {
  url: {{adminUrl}}/changePassword.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-User-ID: {{adminId}}
}

body:json {
  {
    "userId": {{userId}},
    "password": "{{newTestPassword}}"
  }
}

tests {
  test("admin change password returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("password change message is returned", function() {
    expect(res.body.message).to.equal("User password changed.");
  });
}
