meta {
  name: Login - Success
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "login": "{{testLogin}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("successful login returns 200 and a user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.login).to.equal(bru.getEnvVar("testLogin"));
  });
}
