meta {
  name: Login With New Password
  type: http
  seq: 17
}

post {
  url: {{authUrl}}/login.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "login": "{{testLogin}}",
    "password": "{{newTestPassword}}"
  }
}

tests {
  test("user login with new password returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("same user logs in", function() {
    expect(res.body.user.id).to.equal(Number(bru.getEnvVar("userId")));
  });
}
