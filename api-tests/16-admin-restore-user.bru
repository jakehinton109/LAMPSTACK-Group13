meta {
  name: Admin - Restore User
  type: http
  seq: 16
}

put {
  url: {{adminUrl}}/suspendUser.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-User-ID: {{adminId}}
}

body:json {
  {
    "userId": {{userId}},
    "disabled": 0
  }
}

tests {
  test("admin restore user returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("restore message is returned", function() {
    expect(res.body.message).to.equal("User account restored.");
  });
}
