meta {
  name: Create Contact
  type: http
  seq: 4
}

post {
  url: {{manageUrl}}/createContact.php
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-User-ID: {{userId}}
}

body:json {
  {
    "firstName": "John",
    "lastName": "Smith",
    "phone": "555-123-4567",
    "email": "john.smith@example.com",
    "teamName": "API Test Team",
    "position": "QB",
    "side": "Offense"
  }
}

tests {
  test("contact creation returns 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body.contactId).to.be.a("number");
  });

  test("contact creation returns message", function() {
    expect(res.body.message).to.equal("Contact created!");
  });
}

script:post-response {
  if (res.body.contactId) {
    bru.setEnvVar("contactId", res.body.contactId);
  }
}
