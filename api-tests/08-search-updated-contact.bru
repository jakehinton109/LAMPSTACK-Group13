meta {
  name: Search Updated Contact
  type: http
  seq: 8
}

get {
  url: {{searchUrl}}/searchContacts.php?q=Updated%20API%20Test%20Team
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-User-ID: {{userId}}
}

tests {
  test("search returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("updated contact exists", function() {
    const contact = res.body.results.find(
      item => item.id == bru.getEnvVar("contactId")
    );

    expect(contact).to.not.equal(undefined);
    expect(contact.email).to.equal("updated.john@example.com");
    expect(contact.phone).to.equal("555-999-9999");
    expect(contact.teamName).to.equal("Updated API Test Team");
  });
}
